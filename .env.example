# Copie este arquivo para .env e preencha a chave.
# Chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-aqui

# Modelo usado pelos agentes (formato do CrewAI: provedor/modelo)
SDD_MODEL=gemini/gemini-3.5-flash-lite

# Modelos de reserva (separados por vírgula), usados se o principal estiver
# sobrecarregado (erro 503). Veja os disponíveis com: python main.py --modelos
SDD_MODELOS_RESERVA=gemini/gemini-flash-latest,gemini/gemini-flash-lite-latest

# Limite de tokens da resposta (o código completo precisa caber aqui)
SDD_MAX_TOKENS=32768
